{
  "expo": {
    "name": "Musix",
    "slug": "musix",
    "version": "1.0.0",
    "scheme": "musix",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.musix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F0F0F"
      },
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bc273e4-9c31-4591-8c22-ce7101f9dee2"
      }
    }
  }
}
