{
  "expo": {
    "name": "Musix",
    "slug": "musixynov",
    "version": "1.0.0",
    "scheme": "musix",
    "userInterfaceStyle": "dark",
    "platforms": ["android", "ios"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "android": {
      "package": "com.musix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "navigationBar": {
        "style": "dark",
        "backgroundColor": "#0A0A0A"
      }
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "78bbe8b1-d0e8-4107-8d31-453f33c68b57"
      }
    },
    "owner": "musix_ynov"
  }
}
